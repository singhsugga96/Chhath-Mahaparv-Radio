---
/**
 * The site's Instagram, top left.
 *
 * Sits opposite the playlist link so the two corners balance, and stays fixed so
 * it is visible from the first screen rather than only at the end of the journey.
 * Reads as an invitation to follow rather than a byline.
 *
 * The glyph is a plain camera outline, not Instagram's logo, so nothing
 * trademarked is reproduced.
 */
const HANDLE = 'together_with_suditi';
---

<a
  class="follow"
  href={`https://www.instagram.com/${HANDLE}/`}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Follow ${HANDLE} on Instagram. Opens in a new tab.`}
>
  <svg class="follow__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <rect
      x="3"
      y="3"
      width="18"
      height="18"
      rx="5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
    ></rect>
    <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
    <circle cx="17.2" cy="6.8" r="1.2" fill="currentColor"></circle>
  </svg>

  <span class="follow__text">
    <span class="follow__sub">फ़ॉलो करें · follow us</span>
    <span class="follow__handle">@{HANDLE}</span>
  </span>
</a>
