---
import Analytics from '../components/Analytics.astro';
import EntryGate from '../components/EntryGate.astro';
import Follow from '../components/Follow.astro';
import PlaylistLink from '../components/PlaylistLink.astro';
import Player from '../components/Player.astro';
import Scene from '../components/Scene.astro';
import Section from '../components/Section.astro';
import Seo from '../components/Seo.astro';
import { SECTIONS } from '../content/ritual';
import { BRAND, BRAND_HI, TAGLINE } from '../lib/brand';
import '../styles/global.css';
---

<!doctype html>
<html lang="hi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo />
    <link rel="preconnect" href="https://www.youtube.com" />
    <link rel="preconnect" href="https://i.ytimg.com" />
    <Analytics />
  </head>
  <body>
    <!--
      The page's only h1. Visually hidden because the entry screen carries the
      wordmark as art, but it still has to state the brand and the subject for
      search engines and screen readers.
    -->
    <h1 class="sr-only">{BRAND_HI} · {BRAND}: {TAGLINE}</h1>

    <Scene />

    <Follow />
    <PlaylistLink />

    <main class="journey">
      {
        SECTIONS.map((section, i) => (
          <Section section={section} isIntro={i === 0} />
        ))
      }
    </main>

    <!-- Jump-to-section rail. Hidden on narrow viewports. -->
    <nav aria-label="Sections">
      <ul class="rail">
        {
          SECTIONS.map((section, i) => (
            <li>
              <button
                class="rail__dot"
                type="button"
                data-target={section.id}
                aria-current={i === 0 ? 'true' : 'false'}
                aria-label={`${section.titleEn}, ${section.titleHi}`}
              />
            </li>
          ))
        }
      </ul>
    </nav>

    <!--
      Shown only while the page is scrolling itself. Without it, a page that
      starts moving on its own reads as a glitch rather than a guided tour.
    -->
    <p class="autoscroll-hint" id="autoscroll-hint" role="status" hidden>
      पेज अपने आप चल रहा है, छूते ही रुक जाएगा
      <span class="autoscroll-hint__en">scrolling on its own, touch to take over</span>
    </p>

    <Player />
    <EntryGate />

    <script>
      import '../scripts/boot';
    </script>
  </body>
</html>
